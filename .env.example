ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:7000

PORT=8000

# Production model selection for the Purchasing AI late-delivery risk service.
# Allowed values:
#   xgboost           — XGBoost Classifier  (default)
#   linear_regression — Linear Regression Classifier
#
# Example:
#   PURCHASING_AI_MODEL=xgboost
#   PURCHASING_AI_MODEL=linear_regression
#
# If not set, defaults to xgboost (preserves existing behaviour).
PURCHASING_AI_MODEL=xgboost
